{% set messageObject = messageObject|default(null) %}
{% if messageObject is null and message is defined and message is not empty %}
    {% if message.content is defined %}
        {% set messageObject = message %}
    {% endif %}
{% endif %}

{% if message is defined and message is same as(messageObject) %}
    {% set message = messageObject.content %}
{% else %}
    {% set message = message|default(messageObject ? messageObject.content : '') %}
{% endif %}

{% set author = author|default(messageObject ? messageObject.author : null) %}
{% set timestamp = timestamp|default(messageObject ? messageObject.createdAt : null) %}
{% set message_id = message_id|default(messageObject ? messageObject.id : 0) %}
{% set updated_at = updated_at|default(messageObject ? messageObject.updatedAt : null) %}
{% set fileName = fileName|default(messageObject ? messageObject.fileName : null) %}
{% set fileSize = fileSize|default(messageObject ? messageObject.fileSize : null) %}
{% set filePath = filePath|default(messageObject ? messageObject.filePath : null) %}
{% set mimeType = mimeType|default(messageObject ? messageObject.mimeType : null) %}
{% set user_hue = author ? author.hue : 200 %}
{% set username = (messageObject and messageObject.customAuthorName) ? messageObject.customAuthorName : (author ? (author.displayName|default(author.username)) : (user|default('Utilisateur'|trans))) %}
{% set messageChannel = messageObject ? messageObject.getChannel() : null %}
{% set isThisMessagePinned = messageChannel and messageChannel.pinnedMessage and messageChannel.pinnedMessage.id == message_id %}
{% set isMeMessage = message is not null and (message starts with '/me ' or message == '/me') %}
{% set subchannelByParentMessageId = subchannelByParentMessageId|default({}) %}
{% set pollHasVotes = messageObject and messageObject.poll and messageObject.poll.totalVotes > 0 %}
{% set isTodoCompleted = false %}
{% if messageChannel and messageChannel.isTodoList() and messageObject %}
    {% for reaction in messageObject.reactions %}
        {% if reaction.emoji == '✅' %}
            {% set isTodoCompleted = true %}
        {% endif %}
    {% endfor %}
{% endif %}
<div
    class="feed-item {{ (oob|default(false) or no_fade|default(false)) ? '' : 'fade-in' }} {{ isThisMessagePinned ? 'is-pinned' : '' }} {{ isMeMessage ? 'is-me-message' : '' }} {{ isTodoCompleted ? 'todo-completed' : '' }} {{ (messageChannel and messageChannel.isTodoList()) ? 'is-todo-channel-item' : '' }}"
     id="feed-item-{{ message_id|default('') }}" {% if oob|default(false) %}hx-swap-oob="morph"{% endif %}
     style="--user-hue: {{ user_hue }};" data-message-id="{{ message_id|default('') }}"
     data-author-username="{{ author ? author.username : '' }}" data-raw-content="{{ message|default('') }}"
     data-file-name="{{ fileName|default('') }}" data-file-size="{{ fileSize|default('') }}"
    data-poll-has-votes="{{ pollHasVotes ? '1' : '0' }}"
    data-is-author="{% if app.user and author and author.username == app.user.username %}true{% else %}false{% endif %}"
    {% if isLast|default(false) %}data-last-message="true"{% endif %}>
    {% if isMeMessage %}
        {% include 'dashboard/feed_item/_me.html.twig' %}
    {% else %}
        <div class="feed-item-header">
            {% if messageChannel is null or not messageChannel.isTodoList() %}
                <div class="feed-item-user-container">
                    {% if author and author.username != 'robot-roquette' %}
                        <a href="{{ path('app_dm_open', {username: author.username}) }}" class="feed-item-user-link" hx-boost="false"
                           title="{{ 'Discuter en privé avec %username% (%status%)'|trans({'%username%': username, '%status%': author.statusLabel|trans}) }}">
                            <div class="avatar-container">
                                {% if messageObject and messageObject.customAuthorAvatar %}
                                    {% if messageObject.customAuthorAvatar starts with 'https://' or messageObject.customAuthorAvatar starts with 'http://' or messageObject.customAuthorAvatar starts with '/' %}
                                        <img src="{{ messageObject.customAuthorAvatar }}" class="feed-item-avatar-img">
                                     {% else %}
                                         <span class="feed-item-avatar">{{ messageObject.customAuthorAvatar }}</span>
                                     {% endif %}
                                 {% else %}
                                     <span class="feed-item-avatar">{{ username|slice(0, 1)|upper }}</span>
                                 {% endif %}
                                 <span class="status-dot-overlay {{ author.status }}"
                                       data-username="{{ author.username }}"
                                       data-status-override="{{ author.statusOverride|default('auto') }}"
                                       data-last-active="{{ author.lastActiveAt ? author.lastActiveAt.timestamp : '' }}"
                                        title="{{ author.statusLabel|trans }}"></span>
                              </div>
                              <span class="feed-item-user">{{ username|wrap_emojis }}</span>
                         </a>
                     {% else %}
                         <div class="avatar-container">
                             {% if messageObject and messageObject.customAuthorAvatar %}
                                 {% if messageObject.customAuthorAvatar starts with 'https://' or messageObject.customAuthorAvatar starts with 'http://' or messageObject.customAuthorAvatar starts with '/' %}
                                     <img src="{{ messageObject.customAuthorAvatar }}" class="feed-item-avatar-img">
                                {% else %}
                                    <span class="feed-item-avatar">{{ messageObject.customAuthorAvatar }}</span>
                                {% endif %}
                            {% else %}
                                <span class="feed-item-avatar">{{ username|slice(0, 1)|upper }}</span>
                            {% endif %}
                            {% if author %}
                                <span class="status-dot-overlay {{ author.status }}"
                                      data-username="{{ author.username }}"
                                      data-status-override="{{ author.statusOverride|default('auto') }}"
                                      data-last-active="{{ author.lastActiveAt ? author.lastActiveAt.timestamp : '' }}"
                                       title="{{ author.statusLabel|trans }}"></span>
                            {% endif %}
                        </div>
                        <span class="feed-item-user">{{ username|wrap_emojis }}</span>
                    {% endif %}
                </div>
                <span
                    class="feed-item-time">{% if timestamp|date('Y-m-d') != 'now'|date('Y-m-d') %}{{ timestamp|date('d/m/Y') }} {% endif %}{{ timestamp|date('H:i') }}</span>
                {% if updated_at is defined and updated_at %}
                    <span class="feed-item-edited-indicator"
                          title="{{ 'Modifié le'|trans }} {{ updated_at|date('d/m/Y H:i') }}">({{ 'modifié'|trans }})</span>
                {% endif %}
                {% if isThisMessagePinned %}
                    <span class="feed-item-pinned-indicator"
                          title="{{ 'Message épinglé dans ce canal'|trans }}">📌 {{ 'Épinglé'|trans }}</span>
                {% endif %}
                {% set subChannel = messageObject ? (subchannelByParentMessageId[message_id] ?? get_subchannel(messageObject)) : null %}
                {% set hasSubChannel = subChannel and (channel is not defined or channel is null or subChannel.id != channel.id) and (activeChannel is not defined or activeChannel is null or subChannel.id != activeChannel.id) %}
                {% if hasSubChannel %}
                    {% set subUnread = unreadCounts[subChannel.id]|default(null) %}
                    {% set subCount = subUnread ? subUnread.count : 0 %}
                    <span class="subchannel-indicator" title="{{ subChannel.isTodoList() ? 'Ce message a un todo'|trans : 'Ce message a une discussion'|trans }}">
                        {% if subChannel.isTodoList() %}
                            ✅ {{ 'todo'|trans }}
                        {% else %}
                            💬 {{ 'discussion'|trans }}
                        {% endif %}
                        {% if subCount > 0 %}
                            <span class="unread-badge feed-item-unread-badge">{{ subCount }}</span>
                        {% endif %}
                    </span>
                {% endif %}
            {% endif %}
            {% include 'dashboard/_feed_item_actions.html.twig' %}
        </div>
        {% if messageObject and messageObject.parentMessage %}
            {% set parentContent = messageObject.parentMessage.content|default('') %}
            {% set parentPreview = parentContent|striptags|u.truncate(120, '…') %}
            {% set parentAuthor = messageObject.parentMessage.author.displayName|default(messageObject.parentMessage.author.username) %}
            <div class="reply-context-bar">
                <a href="#feed-item-{{ messageObject.parentMessage.id }}" class="reply-context-link"
                   onclick="event.preventDefault(); var el=document.getElementById('feed-item-{{ messageObject.parentMessage.id }}'); if(el)el.scrollIntoView({behavior:'smooth',block:'center'});">
                    ↩ <strong>{{ parentAuthor }}</strong>
                </a>
                <span class="reply-context-snippet">{{ parentPreview }}</span>
            </div>
        {% endif %}
        <div class="feed-item-body">
            {% if messageObject is defined and messageObject and messageObject.poll %}
                {% include 'dashboard/_poll.html.twig' with { poll: messageObject.poll } %}
            {% else %}
                {% set scanStatusKey = messageObject ? messageObject.virusScanStatus|default('none') : 'none' %}
                {% set moderationStatusKey = messageObject ? messageObject.moderationStatus|default('none') : 'none' %}
                {% set cacheKey = 'feed_item_body_' ~ message_id ~ '_' ~ scanStatusKey ~ '_' ~ moderationStatusKey ~ '_' ~ (updated_at ? updated_at.timestamp : (timestamp ? timestamp.timestamp : 0)) ~ '_' ~ (message|default('')|length) %}
                {% cache cacheKey %}
                    {% if message is defined and message is not empty and message != '' %}
                        {% if messageObject and messageObject.moderationStatus and messageObject.moderationStatus != 'clean' %}
                            <div class="moderation-badge moderation-{{ messageObject.moderationStatus }}" title="{{ messageObject.moderationReason|default('') }}">
                                <span class="moderation-icon">🛡️</span>
                                <span class="moderation-label">
                                    {% if messageObject.moderationStatus == 'masked' %}
                                        {{ 'Donnée sensible masquée par la modération IA'|trans }}
                                    {% else %}
                                        {{ 'Signalé par la modération'|trans }} ({{ messageObject.moderationReason }})
                                    {% endif %}
                                </span>
                            </div>
                        {% endif %}
                        <div class="feed-item-content-area">
                            {% if is_html|default(false) %}
                                {{ message|raw }}
                            {% elseif messageObject and messageObject.formattedContent is not null %}
                                {{ messageObject.formattedContent|raw }}
                            {% else %}
                                <p>{{ message|format_message }}</p>
                            {% endif %}
                        </div>
                        {% include 'dashboard/feed_item/_link_previews.html.twig' %}
                    {% endif %}


                    {% if fileName is defined and fileName %}
                        {% include 'dashboard/feed_item/_attachment.html.twig' with {isSubchannelParent: isSubchannelParent|default(false)} %}
                    {% endif %}
                {% endcache %}
            {% endif %}

            {% if messageObject is defined and messageObject and not messageObject.poll and message is defined and message is not empty and message != '' %}
                {% set msgReplyCount = replyCounts[message_id]|default(0) %}
                {% set hasReplies = msgReplyCount > 0 %}
                {% if hasReplies %}
                    <div class="feed-item-actions-wrapper">
                        <div class="feed-item-action-buttons">
                            <a href="#"
                               hx-get="{{ path('app_message_replies', {id: message_id}) }}"
                               hx-target="#live-feed"
                               hx-swap="innerHTML transition:false"
                               class="thread-link">
                                💬 {{ 'réponses (%count%)'|trans({'%count%': msgReplyCount}) }}
                            </a>
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            {% if messageChannel is null or not messageChannel.isTodoList() %}
                {% include 'dashboard/_feed_item_reactions.html.twig' %}
            {% endif %}
        </div>
        {% if messageChannel and messageChannel.isTodoList() %}
            {% set subChannel = messageObject ? (subchannelByParentMessageId[message_id] ?? get_subchannel(messageObject)) : null %}
            {% if subChannel and (channel is not defined or channel is null or subChannel.id != channel.id) and (activeChannel is not defined or activeChannel is null or subChannel.id != activeChannel.id) %}
                {% set subUnread = unreadCounts[subChannel.id]|default(null) %}
                {% set subCount = subUnread ? subUnread.count : 0 %}
                <span class="subchannel-indicator">
                    {% if subChannel.isTodoList() %}
                        ✅ {{ 'todo'|trans }}
                    {% else %}
                        💬 {{ 'discussion'|trans }}
                    {% endif %}
                    {% if subCount > 0 %}
                        <span class="unread-badge feed-item-unread-badge">{{ subCount }}</span>
                    {% endif %}
                </span>
            {% endif %}
            {% include 'dashboard/_feed_item_reactions.html.twig' %}
        {% endif %}
    {% endif %}

</div>
