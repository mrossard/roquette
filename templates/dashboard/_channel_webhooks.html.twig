<div id="channel-webhooks-container" class="settings-group">
    <div class="settings-card">
        <div class="settings-card-header">
            <h4 class="settings-card-title">🔗 {{ 'Webhooks entrants'|trans }}</h4>
            <p class="settings-card-desc">
                {{ 'Les webhooks entrants permettent à des applications externes (GitHub, GitLab, alertes...) de publier des messages dans ce canal.'|trans }}
            </p>
        </div>

        <div id="webhooks-list" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.25rem;">
            {% if webhooks is empty %}
                <div style="font-size: 0.85rem; color: var(--text-muted); font-style: italic; padding: 0.5rem 0;">
                    {{ 'Aucun webhook configuré pour ce canal.'|trans }}
                </div>
            {% else %}
                {% for webhook in webhooks %}
                    <div class="webhook-item" id="webhook-{{ webhook.id }}"
                         style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-glass); border-radius: 0.6rem; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">

                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
                            <span style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">
                                {{ webhook.name }}
                            </span>

                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <!-- Active/Inactive Status Toggle -->
                                <button type="button"
                                        hx-post="{{ path('app_webhook_toggle', {id: webhook.id}) }}"
                                        hx-target="#channel-webhooks-container"
                                        hx-swap="outerHTML"
                                        style="background: none; border: none; cursor: pointer; padding: 0.25rem 0.6rem; font-size: 0.75rem; border-radius: 0.35rem; font-weight: 600; color: {{ webhook.isActive ? '#10b981' : '#ef4444' }}; border: 1px solid {{ webhook.isActive ? 'rgba(16, 185, 129, 0.3)' : 'rgba(239, 68, 68, 0.3)' }}; background: {{ webhook.isActive ? 'rgba(16, 185, 129, 0.1)' : 'rgba(239, 68, 68, 0.1)' }}; transition: var(--transition-smooth);">
                                    {{ webhook.isActive ? 'Actif'|trans : 'Inactif'|trans }}
                                </button>

                                <!-- Delete Button -->
                                <button type="button"
                                        hx-post="{{ path('app_webhook_delete', {id: webhook.id}) }}"
                                        hx-target="#channel-webhooks-container"
                                        hx-swap="outerHTML"
                                        hx-confirm="{{ 'Êtes-vous sûr de vouloir supprimer ce webhook ?'|trans }}"
                                        style="background: none; border: none; cursor: pointer; color: var(--accent-red, #ff5b5b); font-size: 0.9rem; padding: 0.25rem; line-height: 1;"
                                        title="{{ 'Supprimer'|trans }}">
                                    🗑️
                                </button>
                            </div>
                        </div>

                        <!-- Webhook URL Display & Copy -->
                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                            {% set webhookUrl = url('app_webhook_incoming', {token: webhook.token}) %}
                            <input type="text" readonly value="{{ webhookUrl }}"
                                   style="background: var(--bg-input-focus); border: 1px solid var(--border-input); border-radius: 0.4rem; color: var(--text-muted); padding: 0.35rem 0.6rem; font-size: 0.75rem; flex: 1; font-family: var(--font-monospace); outline: none;"
                                   onclick="this.select();">

                            <button type="button" class="btn-copy-webhook"
                                    onclick="navigator.clipboard.writeText('{{ webhookUrl }}'); const b = this; b.textContent = 'Copié !'; setTimeout(() => b.textContent = '📋', 1500);"
                                    style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-glass); color: var(--text-primary); cursor: pointer; padding: 0.35rem 0.6rem; border-radius: 0.4rem; font-size: 0.8rem; transition: var(--transition-smooth);"
                                    title="{{ 'Copier l\'URL'|trans }}">
                                📋
                            </button>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>

    <!-- Create Webhook Form -->
    <div class="settings-card">
        <h4 class="settings-card-title">➕ {{ 'Créer un webhook'|trans }}</h4>
        <form hx-post="{{ path('app_webhook_create', {slug: activeChannel.slug}) }}"
              hx-target="#channel-webhooks-container"
              hx-swap="outerHTML"
              style="display: flex; gap: 0.5rem; align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 180px; display: flex; flex-direction: column; gap: 0.35rem;">
                <label for="new-webhook-name"
                       style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">{{ 'Nouveau webhook (Nom)'|trans }}</label>
                <input type="text" id="new-webhook-name" name="name" required placeholder="Ex: GitHub, GitLab, Alerting..."
                       class="input-sidebar" style="font-size: 0.85rem; padding: 0.5rem 0.75rem;">
            </div>
            <button type="submit" class="btn-publish"
                    style="width: auto; padding: 0.5rem 1rem; font-size: 0.85rem; margin: 0; white-space: nowrap;">
                {{ 'Créer'|trans }}
            </button>
        </form>
    </div>
</div>
