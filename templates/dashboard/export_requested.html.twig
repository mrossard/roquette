{% embed 'partials/_modal_layout.html.twig' with {
    id: 'export-requested-modal',
    content_style: 'max-width: 520px;'
} %}
    {% block modal_title %}
        <span style="display: flex; align-items: center; gap: 0.5rem;">
            📤 {{ 'Export demandé'|trans }}
        </span>
    {% endblock %}

    {% block modal_body %}
        <div class="modal-body" style="color: var(--text-primary); font-size: 0.95rem; line-height: 1.6; padding: 1rem 0;">
            <p style="margin: 0 0 1rem 0;">
                {{ "L'exportation du canal"|trans }} <strong>#{{ channel.name }}</strong> {{ "a commencé en arrière-plan."|trans }}
            </p>
            <p style="margin: 0 0 1.5rem 0; color: var(--text-muted); font-size: 0.9rem;">
                {{ "Cette opération peut prendre quelques instants selon le volume de messages et de fichiers joints. Le Robot Roquette vous enverra un message privé contenant le lien de téléchargement dès que l'archive sera prête."|trans }}
            </p>
        </div>

        <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1rem;">
            <form method="dialog">
                <button type="submit" class="btn-cancel"
                        style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-glass); color: var(--text-primary); padding: 0.5rem 1.25rem; border-radius: 0.5rem; cursor: pointer; transition: background 0.2s;">
                    {{ 'Fermer'|trans }}
                </button>
            </form>
        </div>
    {% endblock %}
{% endembed %}
