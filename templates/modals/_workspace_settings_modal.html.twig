{% embed 'partials/_modal_layout.html.twig' with {
    id: 'workspace-settings-modal',
    title: ('Paramètres de l\'espace "' ~ workspace.name ~ '"')|trans
} %}
    {% block modal_body %}
        <form action="{{ path('app_workspace_edit', {slug: workspace.slug}) }}" method="POST" enctype="multipart/form-data" hx-boost="false">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('app') }}">
            <div class="input-group">
                <label for="ws-name">{{ "Nom de l'espace"|trans }}</label>
                <input type="text" id="ws-name" name="name" required value="{{ workspace.name }}" maxlength="255"
                       class="input-sidebar">
            </div>
            <div class="input-group" style="margin-top: 0.5rem;">
                <label for="ws-description">{{ 'Description'|trans }}</label>
                <input type="text" id="ws-description" name="description" value="{{ workspace.description ?? '' }}"
                       maxlength="255" class="input-sidebar">
            </div>
            
            {% if workspace.avatarPath %}
                <div class="input-group" style="margin-top: 0.5rem;">
                    <label>{{ "Avatar actuel"|trans }}</label>
                    <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.25rem;">
                        <img src="{{ path('app_workspace_avatar', {slug: workspace.slug}) }}" alt="Avatar" style="width: 48px; height: 48px; border-radius: 0.6rem; object-fit: cover; border: 1px solid var(--border-glass);">
                        <button type="submit" name="delete_avatar" value="1" class="btn-publish" style="background: var(--accent-red); margin: 0; padding: 0.35rem 0.75rem; font-size: 0.8rem; color: #fff;">
                            {{ "Supprimer l'avatar"|trans }}
                        </button>
                    </div>
                </div>
            {% endif %}

            <div class="input-group" style="margin-top: 0.5rem;">
                <label for="ws-avatar">{{ 'Importer un avatar'|trans }}</label>
                <input type="file" id="ws-avatar" name="avatar" accept="image/*" class="input-sidebar">
            </div>

            <button type="submit" class="btn-publish" style="margin-top: 1.25rem;">{{ 'Enregistrer les modifications'|trans }}</button>
        </form>

        {% if workspace.creator and workspace.creator.id == app.user.id or is_granted('ROLE_ADMIN') %}
            {% if not workspace.isPublic %}
                <hr style="margin: 1.5rem 0; border-color: var(--border-glass);">
                <form action="{{ path('app_workspace_delete', {slug: workspace.slug}) }}" method="POST"
                      onsubmit="return confirm('{{ 'Êtes-vous sûr de vouloir supprimer cet espace ? Tous les canaux et messages seront perdus.'|trans }}');">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('app') }}">
                    <button type="submit" class="btn-publish" style="background: var(--accent-red);">{{ 'Supprimer l\'espace'|trans }}</button>
                </form>
            {% endif %}
        {% endif %}
    {% endblock %}
{% endembed %}
